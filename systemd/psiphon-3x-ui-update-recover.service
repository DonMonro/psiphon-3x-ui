[Unit]
Description=Psiphon-3X-UI interrupted update recovery
Documentation=https://github.com/DonMonro/psiphon-3x-ui
DefaultDependencies=no
After=local-fs.target
Before=psiphon-3x-ui.service multi-user.target

[Service]
Type=oneshot
# Stay active so a panel start initiated by post-exit recovery does not
# schedule this ordering dependency again inside the install job.
RemainAfterExit=yes
RuntimeDirectory=psiphon-3x-ui-updater
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
User=root
Group=root
WorkingDirectory=/
# recovery.py is the helper saved before candidate activation. It remains
# usable if the newly installed helper cannot parse after a power loss.
ExecStart=/usr/bin/python3 -I /var/lib/psiphon-3x-ui-updater/recovery.py recover --boot --prefix /opt/psiphon-3x-ui --user psiphon3xui --group psiphon3xui
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/psiphon-3x-ui /var/lib/psiphon-3x-ui-updater /run/psiphon-3x-ui-updater /etc/systemd/system /etc/polkit-1/rules.d /usr/local/libexec/psiphon-3x-ui
UMask=0077
TimeoutStartSec=180s
