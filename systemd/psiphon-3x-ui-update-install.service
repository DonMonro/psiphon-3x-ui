[Unit]
Description=Psiphon-3X-UI staged update installation
Documentation=https://github.com/DonMonro/psiphon-3x-ui
After=network-online.target psiphon-3x-ui-update-recover.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
RuntimeDirectory=psiphon-3x-ui-updater
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 -I /usr/local/libexec/psiphon-3x-ui/update_panel.py install --prefix /opt/psiphon-3x-ui --user psiphon3xui --group psiphon3xui
# Always use the previous trusted helper for post-exit recovery, even when
# candidate activation replaced update_panel.py or the worker was killed.
ExecStopPost=/usr/bin/python3 -I /var/lib/psiphon-3x-ui-updater/recovery.py recover --after-job --prefix /opt/psiphon-3x-ui --user psiphon3xui --group psiphon3xui
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Database rollback uses atomic rename and SQLite sidecars in the prefix.
ReadWritePaths=/opt/psiphon-3x-ui /var/lib/psiphon-3x-ui-updater /run/psiphon-3x-ui-updater /etc/systemd/system /etc/polkit-1/rules.d /usr/local/libexec/psiphon-3x-ui
UMask=0077
TimeoutStartSec=2700s
TimeoutStopSec=180s
KillMode=control-group
