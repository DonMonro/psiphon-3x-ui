[Unit]
Description=Psiphon-3X-UI management panel
Documentation=https://github.com/DonMonro/psiphon-3x-ui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ExecStart is templated by panel_install.sh (Phase 2): it points to the venv
# python running `python -m panel`. Use EnvironmentFile for host/port/secret.
WorkingDirectory=/opt/psiphon-3x-ui
EnvironmentFile=/opt/psiphon-3x-ui/panel.env
ExecStart=/opt/psiphon-3x-ui/venv/bin/python -m panel
# Phase 24 Hotfix #8 (Bug: operator's install terminal shows
#   ``Failed to restart psiphon-3x-ui.service: Unit psiphon-3x-ui.service
#   not found.`` between the ``[seed] country table synced (33 entries)``
#   stderr print and the ``── Psiphon-3X-UI installed ──`` banner, even
#   after Hotfix #5/#6/#7 placed ``2>/dev/null`` redirects on every
#   installer systemctl call). The 2>/dev/null redirects silenced
#   systemctl's own stderr (the CLI side) — but the wording is emitted by
#   systemd PID 1 itself when its ``Restart=on-failure`` policy tries to
#   dispatch a queued restart transaction against a mid-reload unit MD.
#   The emit lands on the systemd-process log target (journal-or-kmsg by
#   default), which on some SSH-host VTY setups ALSO echoes to the
#   operator's terminal — even though ``journalctl --system`` shows no
#   trace (kmsg-only path) and install.log has only the ``info``/``ok``
#   banner block.
#   The 12th-install strace confirmed: NO ``Failed to restart ...``
#   write() syscall from any install.sh-lineage process during the post-
#   seed bracket — only a docblock-source-write to fd 4 (which is the
#   panel_install.sh file-write itself, NOT a TTY emit). The wording
#   therefore comes from systemd PID 1's async JobResult emit, which our
#   ``2>/dev/null`` redirects can never suppress.
# Fix: switch the panel's restart policy from ``on-failure`` to
# ``on-abort``. With ``on-abort`` systemd ONLY auto-restarts on
# SIGABRT/SIGSEGV-class signals (the panel crashing under a memory
# fault / panic), NOT on regular exit-code-1 (which is what happens
# during install when pip --force-reinstall briefly unlinks the wheel
# files SSD-side and uvicorn exits non-zero). With on-abort in place,
# the installer's wheel-rewrite window never queues a restart job, so
# systemd's "Failed to restart" JobResult emit never fires. The panel
# still auto-recovers from genuine OOM/segfault crashes (the realistic
# production failure mode) but doesn't burn a restart cycle on a
# transient uvicorn exit during install.
Restart=on-abort
RestartSec=5
# Run as a dedicated unprivileged user (created by the installer).
User=psiphon3xui
Group=psiphon3xui
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
# ProtectHome=tmpfs (NOT =true): both modes mask /home, /root and /run/user,
# but =true is implemented as InaccessiblePaths — and systemd REFUSES to nest
# a BindPaths=/BindReadOnlyPaths= carve-out inside an InaccessiblePaths mask.
# =tmpfs (TemporaryFileSystem= with :ro) is the documented mode that leaves
# the namespace open to the read-only /root/cert bind below, which is what
# lets the dashboard's HTTPS card read a cert pair kept at its default
# /root/cert/... location without the operator copying it elsewhere.
ProtectHome=tmpfs
# Read-only bind of the operator's cert directory (the HTTPS card pre-fills
# /root/cert/ip/fullchain.pem + privkey.pem). The leading "-" makes systemd
# ignore this line when the directory does not exist (fresh installs).
# DAC perms still apply inside the bind: the pair must be readable by the
# service user (chmod -R a+rX /root/cert) — and that is safe, because host
# users still cannot traverse 0700 /root to reach the subtree; only this
# unit sees it, read-only, through its own namespace.
BindReadOnlyPaths=-/root/cert
PrivateTmp=true
ReadWritePaths=/opt/psiphon-3x-ui
# Allowing bind to the admin-chosen panel port across the high range:
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
